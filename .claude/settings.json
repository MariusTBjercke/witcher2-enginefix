{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "PowerShell(.\\build.bat)",
      "PowerShell(& .\\build.bat)",
      "PowerShell(.\\tools\\patchtest\\build.bat)",
      "PowerShell(& .\\tools\\patchtest\\build.bat)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\check-repo.ps1:*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\sync-agent-skills.ps1:*)",
      "Bash(python -I tools/address-table.py:*)"
    ]
  }
}
